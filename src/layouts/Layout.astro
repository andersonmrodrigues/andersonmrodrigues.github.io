---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags: string[];
  };
}

const {
  title = "Anderson Rodrigues - Senior Software Engineer | Clojure & Java Specialist",
  description = "Senior Software Engineer with 8+ years experience building scalable backend services, distributed systems, and financial platforms at Nubank.",
  image = "/favicon.svg",
  article,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://andersonmaikrodrigues.com').href;

// JSON-LD Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Anderson Maik Rodrigues",
  "alternateName": ["Anderson Rodrigues"],
  "url": "https://andersonmaikrodrigues.com",
  "image": "https://andersonmaikrodrigues.com/favicon.svg",
  "jobTitle": "Senior Software Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Nubank",
    "url": "https://nubank.com.br"
  },
  "sameAs": [
    "https://www.linkedin.com/in/andersonmaikrodrigues",
    "https://github.com/andersonmaikon-droid"
  ],
  "knowsAbout": [
    "Distributed Systems",
    "Clojure",
    "Java",
    "Spring Boot",
    "Quarkus",
    "Software Architecture",
    "Event-Driven Architecture",
    "Apache Kafka",
    "Financial Systems",
    "Artificial Intelligence"
  ],
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Universidade de Santa Cruz do Sul"
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Anderson Rodrigues",
  "url": "https://andersonmaikrodrigues.com",
  "author": {
    "@type": "Person",
    "name": "Anderson Maik Rodrigues"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100 antialiased selection:bg-sky-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Anderson Maik Rodrigues" />
    <meta name="keywords" content="Anderson Rodrigues, Senior Software Engineer, Nubank, Clojure, Java, Distributed Systems, Software Architect, Event-Driven Architecture, Microservices, Financial Platforms" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL).href} />
    <meta property="og:site_name" content="Anderson Rodrigues - Personal Website" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL).href} />

    <!-- Article Specific Meta Tags -->
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content={article.author} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <link rel="alternate" type="application/rss+xml" title="Anderson Rodrigues - Engineering Articles" href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col justify-between font-sans">
    
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/60 transition-all">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-white hover:text-sky-400 transition">
          <span class="w-8 h-8 rounded-lg bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 text-sm font-black">AR</span>
          <span>Anderson Rodrigues</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/#about" class="hover:text-sky-400 transition">About</a>
          <a href="/#impact" class="hover:text-sky-400 transition">Impact</a>
          <a href="/#experience" class="hover:text-sky-400 transition">Experience</a>
          <a href="/#expertise" class="hover:text-sky-400 transition">Architecture</a>
          <a href="/blog" class="hover:text-sky-400 transition">Articles</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="https://github.com/andersonmaikon-droid"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-white transition rounded-md hover:bg-slate-800/60"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <a
            href="https://www.linkedin.com/in/andersonmaikrodrigues"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 text-slate-400 hover:text-white transition rounded-md hover:bg-slate-800/60"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.78a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-sky-300 bg-sky-500/10 border border-sky-500/20 rounded-full hover:bg-sky-500/20 transition"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
            llms.txt
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-12 mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
          <p class="text-sm font-semibold text-slate-200">Anderson Maik Rodrigues</p>
          <p class="text-xs text-slate-400 mt-1">Senior Software Engineer @ Nubank • Distributed Systems & Architecture</p>
        </div>

        <div class="flex items-center gap-6 text-sm text-slate-400">
          <a href="https://www.linkedin.com/in/andersonmaikrodrigues" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">LinkedIn</a>
          <a href="https://github.com/andersonmaikon-droid" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">GitHub</a>
          <a href="/rss.xml" class="hover:text-white transition">RSS Feed</a>
          <a href="/llms.txt" class="hover:text-sky-400 transition">LLMs Index</a>
        </div>

        <p class="text-xs text-slate-500">
          © {new Date().getFullYear()} Anderson Rodrigues. All rights reserved.
        </p>
      </div>
    </footer>

  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags: string[];
  };
}

const {
  title = "Anderson Rodrigues - Senior Software Engineer | Clojure & Java Specialist",
  description = "Senior Software Engineer with 8+ years experience building scalable backend services, distributed systems, and financial platforms at Nubank.",
  image = "/favicon.svg",
  article,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://andersonmaikrodrigues.com').href;

// JSON-LD Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Anderson Maik Rodrigues",
  "alternateName": ["Anderson Rodrigues"],
  "url": "https://andersonmaikrodrigues.com",
  "image": "https://andersonmaikrodrigues.com/favicon.svg",
  "jobTitle": "Senior Software Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Nubank",
    "url": "https://nubank.com.br"
  },
  "sameAs": [
    "https://www.linkedin.com/in/andersonmaikrodrigues",
    "https://github.com/andersonmaikon-droid"
  ],
  "knowsAbout": [
    "Distributed Systems",
    "Clojure",
    "Java",
    "Spring Boot",
    "Quarkus",
    "Software Architecture",
    "Event-Driven Architecture",
    "Apache Kafka",
    "Financial Systems",
    "Artificial Intelligence"
  ],
  "alumniOf": {
    "@type": "EducationalOrganization",
    "name": "Universidade de Santa Cruz do Sul"
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Anderson Rodrigues",
  "url": "https://andersonmaikrodrigues.com",
  "author": {
    "@type": "Person",
    "name": "Anderson Maik Rodrigues"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-slate-950 text-slate-100 antialiased selection:bg-sky-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Anderson Maik Rodrigues" />
    <meta name="keywords" content="Anderson Rodrigues, Senior Software Engineer, Nubank, Clojure, Java, Distributed Systems, Software Architect, Event-Driven Architecture, Microservices, Financial Platforms" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL).href} />
    <meta property="og:site_name" content="Anderson Rodrigues - Personal Website" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL).href} />

    <!-- Article Specific Meta Tags -->
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content={article.author} />
        {article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <link rel="alternate" type="application/rss+xml" title="Anderson Rodrigues - Engineering Articles" href="/rss.xml" />
  </head>
  <body class="min-h-screen flex flex-col justify-between font-sans">
    
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/60 transition-all">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-base font-serif font-bold tracking-tight text-white hover:text-sky-400 transition">
          <span>Anderson Rodrigues</span>
        </a>

        <div class="flex items-center gap-5 text-xs font-mono">
          <a href="/" class="text-slate-300 hover:text-white transition">About</a>
          <a href="/blog" class="text-slate-300 hover:text-white transition">Writing</a>
          <a
            href="mailto:andersonmaikrodrigues@gmail.com"
            class="px-3 py-1.5 rounded-lg bg-sky-500/10 border border-sky-500/25 text-sky-400 hover:bg-sky-500/20 hover:text-sky-300 transition flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            Contact
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 py-12 mt-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
        <div>
          <p class="text-slate-200 font-semibold">Anderson Maik Rodrigues</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Senior Software Engineer @ Nubank</p>
        </div>

        <div class="flex items-center gap-5">
          <a href="mailto:andersonmaikrodrigues@gmail.com" class="hover:text-sky-400 transition">Email</a>
          <a href="https://www.linkedin.com/in/andersonmaikrodrigues" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">LinkedIn</a>
          <a href="https://github.com/andersonmaikon-droid" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">GitHub</a>
          <a href="/rss.xml" class="hover:text-white transition">RSS</a>
        </div>
      </div>
    </footer>

  </body>
</html>

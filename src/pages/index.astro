---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Anderson Rodrigues - Senior Software Engineer @ Nubank"
  description="Personal website and engineering writing of Anderson Rodrigues, Senior Software Engineer at Nubank specializing in Clojure, Java, and Distributed Systems."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20 space-y-16">

    <!-- Bio / Header Section -->
    <section class="space-y-6">
      <div class="space-y-2">
        <h1 class="text-4xl sm:text-5xl font-serif text-white tracking-tight leading-tight">
          Anderson Rodrigues
        </h1>
        <p class="text-sm font-mono text-sky-400">
          Senior Software Engineer @ Nubank • Distributed Systems & Clojure
        </p>
      </div>

      <div class="text-slate-300 text-base sm:text-lg leading-relaxed space-y-4">
        <p>
          Hello! I’m Anderson, a Senior Software Engineer with over 8 years of experience designing, building, and operating high-throughput backend services and distributed systems.
        </p>
        <p>
          Currently at <strong class="text-white font-semibold">Nubank</strong>, I engineer credit and payment capabilities at scale using <strong class="text-white font-semibold">Clojure</strong> and functional programming principles. My focus includes post-purchase installment financing, automated financial refund workflows, and high-concurrency payment eligibility engines.
        </p>
        <p>
          Throughout my career, I’ve worked with microservices, event-driven architectures (Kafka), and JVM performance optimization across fintech, banking, and enterprise environments. I also explore AI engineering workflows, having built internal AI-assisted tools for real-time incident diagnostics and evidence collection.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-5 pt-2 font-mono text-xs">
        <a
          href="https://www.linkedin.com/in/andersonmaikrodrigues"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sky-400 hover:underline flex items-center gap-1"
        >
          LinkedIn &rarr;
        </a>
        <a
          href="https://github.com/andersonmaikon-droid"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sky-400 hover:underline flex items-center gap-1"
        >
          GitHub &rarr;
        </a>
        <a
          href="/rss.xml"
          class="text-sky-400 hover:underline flex items-center gap-1"
        >
          RSS Feed &rarr;
        </a>
      </div>
    </section>

    <!-- Technical Writing / Essays -->
    <section class="space-y-8 pt-10 border-t border-slate-800/80">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-serif text-white tracking-tight">Writing & Architecture Deep Dives</h2>
        <a href="/blog" class="text-xs font-mono text-slate-400 hover:text-sky-400 transition">All posts &rarr;</a>
      </div>

      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group space-y-2">
            <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span>•</span>
              <span>{post.data.readTime}</span>
            </div>

            <h3 class="text-xl font-semibold text-white group-hover:text-sky-400 transition leading-snug">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>

            <p class="text-sm text-slate-300 leading-relaxed">
              {post.data.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px] text-slate-400">
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Work Experience / Track Record -->
    <section class="space-y-8 pt-10 border-t border-slate-800/80">
      <h2 class="text-2xl font-serif text-white tracking-tight">Engineering Experience</h2>

      <div class="space-y-10">
        
        <!-- Role 1 -->
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-lg font-bold text-white">Nubank</h3>
            <span class="text-xs font-mono text-slate-400">Apr 2024 – Present</span>
          </div>
          <p class="text-xs font-mono text-sky-400">Senior Software Engineer • Clojure, Distributed Systems, Financial Engineering</p>
          <ul class="text-sm text-slate-300 leading-relaxed space-y-1.5 list-disc list-inside pt-1">
            <li>Developing Post-Purchase Financing infrastructure enabling eligible purchases to be converted into up to 12 installments.</li>
            <li>Built backend APIs for NuPay Credit & Payment Conditions with versioned contracts and sandbox testing.</li>
            <li>Automated multi-installment refund workflows, calculating proportional interest and tax reversals in real-time.</li>
            <li>Contributed to Credit Awareness initiatives driving a 68% conversion increase for NuPay.</li>
            <li>Engineered an internal AI-assisted incident diagnostic tool using agentic workflows and internal knowledge retrieval.</li>
          </ul>
        </div>

        <!-- Role 2 -->
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-lg font-bold text-white">Avenue Code</h3>
            <span class="text-xs font-mono text-slate-400">Jan 2022 – Apr 2024</span>
          </div>
          <p class="text-xs font-mono text-slate-400">Software Engineer / Tech Lead • Java, Spring Boot, AWS</p>
          <ul class="text-sm text-slate-300 leading-relaxed space-y-1.5 list-disc list-inside pt-1">
            <li>Optimized high-traffic Java microservices, reducing system downtime by 40% and API latency by 25%.</li>
            <li>Served as Tech Lead guiding architecture decisions, code reviews, and cross-functional team delivery.</li>
            <li>Architected a data-driven A/B testing and feature flagging platform for high-volume digital products.</li>
          </ul>
        </div>

        <!-- Role 3 -->
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-lg font-bold text-white">NTT DATA Europe & LATAM</h3>
            <span class="text-xs font-mono text-slate-400">Apr 2021 – Jan 2022</span>
          </div>
          <p class="text-xs font-mono text-slate-400">Software Engineer • Java, Apache Kafka, Apache Spark</p>
          <ul class="text-sm text-slate-300 leading-relaxed space-y-1.5 list-disc list-inside pt-1">
            <li>Built a real-time transaction categorization system processing millions of bank transactions daily.</li>
            <li>Optimized event processing pipelines, reducing transaction processing latency by 35%.</li>
          </ul>
        </div>

        <!-- Role 4 -->
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-lg font-bold text-white">APECATUS</h3>
            <span class="text-xs font-mono text-slate-400">Feb 2020 – Apr 2021</span>
          </div>
          <p class="text-xs font-mono text-slate-400">Senior Software Engineer • Java, Quarkus, Angular, AWS</p>
          <ul class="text-sm text-slate-300 leading-relaxed space-y-1.5 list-disc list-inside pt-1">
            <li>Architected scalable cloud infrastructure on AWS and delivered 5+ major LMS releases, improving load times by 50%.</li>
          </ul>
        </div>

        <!-- Role 5 -->
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-lg font-bold text-white">Idealogic Software</h3>
            <span class="text-xs font-mono text-slate-400">Jun 2015 – Feb 2020</span>
          </div>
          <p class="text-xs font-mono text-slate-400">Software Engineer • Java, Spring, AWS</p>
          <ul class="text-sm text-slate-300 leading-relaxed space-y-1.5 list-disc list-inside pt-1">
            <li>Delivered 10+ enterprise production systems (CRM, ERP), automating client workflows by up to 80%.</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- Technical Foundations -->
    <section class="space-y-6 pt-10 border-t border-slate-800/80">
      <h2 class="text-2xl font-serif text-white tracking-tight">Core Domain & Competencies</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm text-slate-300">
        <div>
          <h3 class="font-bold text-white font-mono text-xs uppercase text-sky-400 mb-1">Languages & Paradigms</h3>
          <p>Clojure, Java (6 through 21+), Functional Programming, SQL, Immutable Data Design.</p>
        </div>
        <div>
          <h3 class="font-bold text-white font-mono text-xs uppercase text-sky-400 mb-1">Architecture & Systems</h3>
          <p>Distributed Systems, Event-Driven Architecture, Microservices, Sagas, Domain-Driven Design (DDD).</p>
        </div>
        <div>
          <h3 class="font-bold text-white font-mono text-xs uppercase text-sky-400 mb-1">Frameworks & Messaging</h3>
          <p>Spring Boot, Quarkus, Apache Kafka, Apache Spark, REST APIs, OAuth, Circuit Breakers.</p>
        </div>
        <div>
          <h3 class="font-bold text-white font-mono text-xs uppercase text-sky-400 mb-1">Cloud & AI Tooling</h3>
          <p>AWS (EC2, S3, RDS), Agentic Workflows, AI Incident Diagnostics, Observability (APM, Tracing).</p>
        </div>
      </div>
    </section>

    <!-- Contact & Education -->
    <section class="space-y-4 pt-10 border-t border-slate-800/80 text-sm text-slate-300">
      <h2 class="text-2xl font-serif text-white tracking-tight">Education & Links</h2>
      <p>
        Bachelor’s Degree in Computer Science from <strong class="text-white">Universidade de Santa Cruz do Sul</strong> (2016 – 2023).
      </p>
      <p>
        Feel free to connect on <a href="https://www.linkedin.com/in/andersonmaikrodrigues" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">LinkedIn</a> or explore my code on <a href="https://github.com/andersonmaikon-droid" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">GitHub</a>.
      </p>
    </section>

  </div>
</Layout>

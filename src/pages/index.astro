        <div>
          <h2 class="text-xs font-bold uppercase tracking-widest text-sky-400">Engineering Writing</h2>
          <h3 class="text-3xl sm:text-4xl font-bold text-white mt-2">Technical Articles & Insights</h3>
        </div>
        <a href="/blog" class="text-sm font-semibold text-sky-400 hover:text-sky-300 transition flex items-center gap-1">
          View all articles &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="flex flex-col justify-between p-6 rounded-2xl bg-slate-900 border border-slate-800/80 hover:border-slate-700 transition group">
            <div>
              <div class="flex items-center gap-2 text-xs text-slate-400 mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span>•</span>
                <span>{post.data.readTime}</span>
              </div>
              <h4 class="text-lg font-bold text-white group-hover:text-sky-400 transition leading-snug">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h4>
              <p class="mt-3 text-sm text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-800 text-slate-300 border border-slate-700/50">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={`/blog/${post.id}`} class="text-xs font-bold text-sky-400 group-hover:translate-x-1 transition flex items-center gap-1">
                Read &rarr;
              </a>
            </div>

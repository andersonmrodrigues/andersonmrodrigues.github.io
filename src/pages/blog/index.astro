---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Writing - Anderson Rodrigues"
  description="Technical articles and architecture deep dives by Anderson Rodrigues."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20 space-y-12">
    <div class="space-y-3">
      <h1 class="text-4xl font-serif text-white tracking-tight">Writing</h1>
      <p class="text-slate-300 text-base leading-relaxed">
        Technical articles on distributed systems, AI engineering, Clojure, and software architecture.
      </p>
    </div>

    <div class="space-y-10 pt-6 border-t border-slate-800/80">
      {posts.map((post) => (
        <article class="group space-y-2">
          <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <span>•</span>
            <span>{post.data.readTime}</span>
          </div>

          <h2 class="text-xl font-semibold text-white group-hover:text-sky-400 transition leading-snug">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </h2>

          <p class="text-sm text-slate-300 leading-relaxed">
            {post.data.description}
          </p>

          <div class="flex items-center justify-between pt-2">
            <div class="flex flex-wrap gap-2 font-mono text-[11px] text-slate-400">
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
            <a
              href={`/blog/${post.id}`}
              class="text-xs font-mono text-sky-400 group-hover:underline flex items-center gap-1"
            >
              Read post &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
